{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "dist",
    "rootDir": "src",
  },
  "include": ["src/**/*", "src/constellateRSS", "global.d.ts"],
  "exclude": ["dist", "node_modules"]
}